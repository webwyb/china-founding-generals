    {
      "id": "song",
      "name": "宋庆龄",
      "field": "社会与公共事务",
      "focus": "从故居文物读到公共活动",
      "archiveId": null,
      "paragraphs": [
        {
          "text": "上海宋庆龄故居既是她在上海的寓所，也是她开展公共活动的场所。馆内保存文稿、信函、照片与生活用品，为读者提供了不同类型的历史材料。",
          "sourceUrls": [
            "https://www.shsoong-chingling.com/"
          ]
        },
        {
          "text": "与只看建筑外观相比，关注一封信、一个手稿或一件生活用品，更容易提出具体问题：它由谁使用，写给谁，又记录了什么事情？这些问题需要继续回到馆藏说明与原始材料。",
          "sourceUrls": [
            "https://www.shsoong-chingling.com/"
          ]
        }
      ],
      "milestones": [],
      "connection": {
        "kind": "居住与公共活动地",
        "place": "上海宋庆龄故居",
        "text": "上海宋庆龄故居既是她在上海的寓所，也是她开展公共活动的场所。馆内保存文稿、信函、照片与生活用品，为读者提供了不同类型的历史材料。",
        "sourceUrls": [
          "https://www.shsoong-chingling.com/"
        ]
      },
      "question": "一处住所怎样同时呈现个人生活和公共活动？",
