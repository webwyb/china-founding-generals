{
  "name": "shanhe-youming",
  "version": "0.1.0",
  "private": true,
  "description": "山河有名 · 开国将帅纪念馆，基于 Taro 的 H5 原型",
  "scripts": {
    "dev:h5": "taro build --type h5 --watch",
    "dev:weapp": "taro build --type weapp --watch",
    "build:h5": "taro build --type h5",
    "build:weapp": "taro build --type weapp",
    "build": "npm run build:h5",
    "preview": "node scripts/python.mjs -m http.server 5173 --bind 127.0.0.1 --directory dist/h5",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate_catalog.mjs",
    "validate:design": "node scripts/validate_design.mjs",
    "validate:portraits": "node scripts/validate_portraits.mjs",
    "validate:functions": "node scripts/validate_functionality.mjs",
    "test:catalog": "node scripts/python.mjs scripts/test_catalog_parser.py",
    "setup:python": "node scripts/python.mjs scripts/bootstrap.py",
    "data:build": "node scripts/python.mjs scripts/build_catalog.py",
    "data:verify": "node scripts/verify_catalog.mjs",
    "validate:cards": "node scripts/render_design_cards.mjs",
    "check": "node scripts/check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tarojs/components": "4.3.2",
    "@tarojs/react": "4.3.2",
    "@tarojs/runtime": "4.3.2",
    "@tarojs/shared": "4.3.2",
    "@tarojs/taro": "4.3.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@napi-rs/canvas": "1.1.1",
    "@tarojs/cli": "4.3.2",
    "@tarojs/plugin-framework-react": "4.3.2",
    "@tarojs/plugin-platform-h5": "4.3.2",
    "@tarojs/plugin-platform-weapp": "4.3.2",
    "@tarojs/vite-runner": "4.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "babel-preset-taro": "4.3.2",
    "esbuild": "0.21.5",
    "postcss": "^8.4.49",
    "sass": "^1.83.0",
    "typescript": "~5.7.3",
    "vite": "^4.5.14"
  }
}
