{
  "name": "shanhe-youming",
  "version": "0.1.0",
  "private": true,
  "description": "名在山河 · 开国将帅纪念馆，基于 Taro 的 H5 与微信小程序",
  "scripts": {
    "dev:h5": "taro build --type h5 --watch",
    "dev:weapp": "taro build --type weapp --watch",
    "build:h5": "taro build --type h5 && node scripts/build_analytics.mjs && node scripts/build_seo.mjs && node scripts/validate_seo.mjs",
    "build:assets": "taro build --type h5",
    "build:weapp": "taro build --type weapp",
    "build": "npm run build:h5",
    "preview": "node scripts/python.mjs -m http.server 5173 --bind 127.0.0.1 --directory dist/h5",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate_catalog.mjs",
    "validate:design": "node scripts/validate_design.mjs",
    "validate:portraits": "node scripts/validate_portraits.mjs",
    "validate:functions": "node scripts/validate_functionality.mjs && node scripts/validate_runtime.mjs",
    "audit:images": "node scripts/audit_image_rights.mjs",
    "validate:compliance": "node scripts/validate_compliance.mjs",
    "test:catalog": "node scripts/python.mjs scripts/test_catalog_parser.py",
    "test:biographies": "node scripts/python.mjs scripts/test_biographies.py",
    "test:analytics": "node scripts/test_analytics.mjs",
    "setup:python": "node scripts/python.mjs scripts/bootstrap.py",
    "data:build": "node scripts/python.mjs scripts/build_catalog.py && node scripts/build_client_catalog.mjs",
    "data:verify": "node scripts/verify_catalog.mjs",
    "validate:cards": "node scripts/render_design_cards.mjs",
    "validate:seo": "node scripts/validate_seo.mjs",
    "validate:seo:http": "node scripts/python.mjs scripts/test_seo_http.py",
    "validate:seo:release": "node scripts/python.mjs scripts/deploy/verify-seo-package.py",
    "check": "node scripts/check.mjs",
    "validate:weapp": "node scripts/validate_weapp.mjs",
    "check:weapp": "npm run typecheck && npm run build:weapp && npm run validate:weapp",
    "validate:weapp:online": "node scripts/validate_weapp_online.mjs",
    "validate:topics": "node scripts/validate_topics.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tarojs/components": "4.3.2",
    "@tarojs/react": "4.3.2",
    "@tarojs/runtime": "4.3.2",
    "@tarojs/shared": "4.3.2",
    "@tarojs/taro": "4.3.2",
    "aegis-web-sdk": "1.41.17",
    "qrcode-generator": "2.0.4",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.25.9",
    "@napi-rs/canvas": "1.1.1",
    "@tarojs/cli": "4.3.2",
    "@tarojs/plugin-framework-react": "4.3.2",
    "@tarojs/plugin-platform-h5": "4.3.2",
    "@tarojs/plugin-platform-weapp": "4.3.2",
    "@tarojs/vite-runner": "4.3.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "babel-preset-taro": "4.3.2",
    "esbuild": "0.21.5",
    "jsqr": "1.4.0",
    "postcss": "^8.4.49",
    "sass": "^1.83.0",
    "typescript": "~5.7.3",
    "vite": "^4.5.14"
  }
}
